{
  "hosting": [
    {
      "target": "default",
      "public": ".",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "docs/**", "research/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "staging",
      "public": ".",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "docs/**", "research/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
